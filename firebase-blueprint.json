{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "isSharingEnabled": { "type": "boolean" },
        "onboarded": { "type": "boolean" }
      },
      "required": ["name", "email", "role"]
    },
    "Record": {
      "title": "Medical Record",
      "description": "Medical records uploaded by patients",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "fileURL": { "type": "string" },
        "fileName": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "fileURL", "fileName", "type", "createdAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Health reminders for patients",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string", "enum": ["medication", "appointment", "checkup"] },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "time", "type", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/records/{recordId}": {
      "schema": "Record",
      "description": "Medical record metadata"
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "User health reminders"
    }
  }
}
