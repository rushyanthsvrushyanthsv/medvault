rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isPatientSharing(patientId) {
      return getUserData(patientId).isSharingEnabled == true;
    }
    
    function isDoctor() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'doctor';
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // User can read their own profile
      // Doctor can read patient profile if sharing is enabled
      allow read: if isOwner(userId) || (isDoctor() && isPatientSharing(userId));
      
      // User can create their own profile
      allow create: if isOwner(userId);
      
      // User can update their own profile
      allow update: if isOwner(userId);
    }

    match /records/{recordId} {
      // Patient can read their own records
      // Doctor can read records if patient is sharing
      allow read: if isOwner(resource.data.patientId) || (isDoctor() && isPatientSharing(resource.data.patientId));
      
      // Patient can create records for themselves
      allow create: if isOwner(request.resource.data.patientId);
      
      // Only patient can delete their own records
      allow delete: if isOwner(resource.data.patientId);
    }

    match /reminders/{reminderId} {
      // User can manage their own reminders
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
